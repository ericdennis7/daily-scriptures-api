{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "daily-scriptures-api",
	"main": "src/entry.py",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "api.thesimplebeliever.com",
			"custom_domain": true
		}
	]
}